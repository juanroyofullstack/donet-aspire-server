<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <ExcludeByFile>
            **/tests/**/*.cs,
            **/tests/**/*IntegrationTests*.cs,
            **/tests/**/CosmosIntegrationTests.cs,
            **/src/Api/**/*.cs,
            **/src/AppHost/**/*.cs,
            **/src/Infrastructure/Repositories/CosmosProductDataStore.cs,
            **/src/Infrastructure/Repositories/ICosmosProductDataStore.cs,
            **/obj/**/*.cs
          </ExcludeByFile>
          <Exclude>
            [NetAspireServer.Api]*,
            [NetAspireServer.AppHost]*,
            [NetAspireServer.IntegrationTests]*,
            [Microsoft.AspNetCore.OpenApi]*,
            [*]AutoGeneratedProgram,
            [*]NetAspireServer.Infrastructure.Repositories.CosmosProductDataStore*,
            [*]NetAspireServer.Infrastructure.Repositories.ICosmosProductDataStore*
          </Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
